{
  "//": "Style profiles. One profile selects the representation, budgets, shading model, pixel treatment and gate set for a whole asset. Stage tools read a profile; they never hard-code a style. Keys beginning with // are comments and are ignored by the validator.",
  "//tris": "palette_3d allows 4000 tris, not the 1200 typical of PSX props: tools/glb_contract.py floors a unit at 4000, so a pixel-tier unit below that cannot pass the engine contract. Prop recipes stay far under (barrel and lasrifle are 460).",
  "schema_version": 1,
  "defaults": {
    "render": {
      "aa": false,
      "per_asset_resolution": true
    },
    "animation": {
      "fps_authored": 12
    },
    "gates": []
  },
  "gates": {
    "glb_contract": "3D asset contract (tools/glb_contract.py)",
    "seam": "tileable seam ratio <= 1.5 or absolute <= 0.02",
    "material_flatness": "albedo low-frequency flatness <= 0.15",
    "style_distance": "colour-layout distance within faction reference p95",
    "palette_compliance": "every opaque pixel is in the profile palette or its ink",
    "silhouette": "largest shapes readable at 1x and 2x target zoom",
    "direction_coverage": "every required direction has every required action",
    "timing": "pose-to-pose keys with anticipation and follow-through; no single-frame teleports",
    "texel_grid": "texture pixels map to a constant world size; UVs snapped to grid",
    "sheet_budget": "atlas frame count and page size within the profile budget",
    "readability": "asset distinguishes from its neighbours at final camera distance"
  },
  "profiles": {
    "pbr_3d": {
