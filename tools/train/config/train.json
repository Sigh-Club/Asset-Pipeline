{
  "model_family": "flux2",
  "model_flavour": "klein-4b",
  "pretrained_model_name_or_path": "black-forest-labs/FLUX.2-klein-base-4B",
  "base_model_precision": "int8-sdnq",
  "quantize_via": "cpu",
  "data_backend_config": "tools/train/config/multidatabackend.json",
  "output_dir": "output/train/materials_v1",
  "model_type": "lora",
  "lora_type": "standard",
  "lora_rank": 16,
  "lora_alpha": 16,
  "learning_rate": 1e-4,
  "lr_scheduler": "constant",
  "optimizer": "adamw_bf16",
  "train_batch_size": 1,
  "gradient_checkpointing": true,
  "mixed_precision": "bf16",
  "max_train_steps": 50,
  "checkpoint_step_interval": 250,
  "validation_steps": 50,
  "validation_resolution": "512x512",
  "validation_num_inference_steps": 16,
  "validation_guidance": 4.0,
  "validation_prompt": "seamless tileable texture, worn gunmetal steel, fine scratches, oil sheen",
  "num_eval_images": 1,
  "seed": 7,
  "report_to": "none",
  "push_to_hub": false,
  "disable_bucket_pruning": true,
  "flow_schedule_shift": 3,
  "tracker_run_name": "materials_v1_calibration"
}
